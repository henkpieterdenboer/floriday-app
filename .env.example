# Floriday staging
FLORIDAY_TOKEN_URL=https://idm.staging.floriday.io/oauth2/ausmw6b47z1BnlHkw0h7/v1/token
FLORIDAY_CUSTOMERS_API_BASE_URL=https://api.staging.floriday.io/customers-api-2026v1
FLORIDAY_SUPPLIERS_API_BASE_URL=https://api.staging.floriday.io/suppliers-api-2026v1

# Floriday production (not in use yet)
# FLORIDAY_TOKEN_URL=https://idm.floriday.io/oauth2/aus3testdcf2vyfs70i7/v1/token
# FLORIDAY_CUSTOMERS_API_BASE_URL=https://api.floriday.io/customers-api-2026v1

# Customers side (buyer, auction number 423765)
FLORIDAY_CUSTOMERS_CLIENT_ID=
FLORIDAY_CUSTOMERS_CLIENT_SECRET=
# Generated in the Floriday UI: Settings > Apps & integrations > Integrations.
# Shown only once. Separate key per environment.
FLORIDAY_CUSTOMERS_API_KEY=

# Suppliers side (grower, auction number 75178)
FLORIDAY_SUPPLIERS_CLIENT_ID=
FLORIDAY_SUPPLIERS_CLIENT_SECRET=
FLORIDAY_SUPPLIERS_API_KEY=

# Neon
DATABASE_URL=
DIRECT_URL=

# Beveiligt de cron-route. Vercel stuurt deze mee als Authorization: Bearer <waarde>.
CRON_SECRET=

# Applicatie (toegangsbeheer)
APP_URL=
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# E-mail. Leeg laten valt terug op Ethereal (niets wordt echt verstuurd) - prima tijdens ontwikkelen.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Entra. Leeg laten houdt de aanmeldknop verborgen.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Zet op "false" om de uurlijkse Floriday-synchronisatie stil te leggen. Bedoeld voor een
# omgeving die nog wacht op Floriday-gegevens: die hoort niet elk uur te falen alsof er iets
# kapot is. Regelt alleen Floriday (clock-presales-supply, organisaties) - niet het
# klokaanbod, zie CLOCK_SYNC_ENABLED hieronder.
SYNC_ENABLED=

# Zelfde soort schakelaar, maar voor het klokaanbod (RFH Pre-Auction) apart: die bron praat
# met RFH, niet met Floriday, en hoort dus niet vast te zitten aan SYNC_ENABLED hierboven.
# Zet op "false" om alleen het klokaanbod stil te leggen.
CLOCK_SYNC_ENABLED=

# RFH Pre-Auction staging - het volledige klokaanbod
RFH_PREAUCTION_API_BASE_URL=https://pre-auction-api.staging.rfh-auction.com/v16.0
RFH_PREAUCTION_TOKEN_URL=https://idm.staging.floriday.io/oauth2/aus1w6civoyW4EdjE0h8/v1/token
RFH_PREAUCTION_CLIENT_ID=0oa19yrfd96Maphyz0h8

